{
    "name": "laravel/laravel",
    "description": "The Laravel Framework.",
    "keywords": ["framework", "laravel"],
    "license": "MIT",
    "type": "project",
    "require": {
        "php": ">=7.1.3",
        "barryvdh/laravel-cors": "0.11.*",
        "barryvdh/laravel-debugbar": "^3.0",
        "barryvdh/laravel-dompdf": "^0.8.7",
        "boz14676/laravel-ffmpeg": "^4.0",
        "creativeorange/gravatar": "~1.0",
        "dawson/youtube": "^6.0",
        "dingo/api": "^2",
        "doctrine/dbal": "^2.5",
        "fideloper/proxy": "^4.0",
        "google/recaptcha": "^1.1",
        "guzzlehttp/guzzle": "6.3.*",
        "h4cc/wkhtmltoimage-amd64": "0.12.x",
        "h4cc/wkhtmltopdf-amd64": "0.12.x",
        "intervention/image": "^2.5",
        "jeremykenedy/laravel-exception-notifier": "^1.1",
        "jeremykenedy/laravel-roles": "^1.2",
        "lakshmaji/thumbnail": "^1.4",
        "laravel/cashier": "^10.4",
        "laravel/framework": "5.8.*",
        "laravel/passport": "^7.5",
        "laravel/socialite": "^3.0",
        "laravel/tinker": "^1.0",
        "laravelcollective/html": "^5.5",
        "league/flysystem-aws-s3-v3": "^1.0",
        "maatwebsite/excel": "^3.1",
        "pbmedia/laravel-ffmpeg": "4.0",
        "phpoffice/phpspreadsheet": "^1.9",
        "rap2hpoutre/laravel-log-viewer": "^0.10.4",
        "socialiteproviders/37signals": "^3.0",
        "socialiteproviders/generators": "^2.0",
        "socialiteproviders/instagram": "^3.0",
        "socialiteproviders/twitch": "^3.0",
        "socialiteproviders/youtube": "^3.0",
        "stripe/stripe-php": "^7.7",
        "tymon/jwt-auth": "1.0.*",
        "webdevetc/blogetc": "^8.4",
        "webpatser/laravel-uuid": "^2.0"
    },
    "require-dev": {
        "filp/whoops": "^2.0",
        "fzaninotto/faker": "^1.4",
        "mockery/mockery": "^1.0",
        "nunomaduro/collision": "^2.0",
        "phpunit/phpunit": "^7.0"
    },
    "autoload": {
        "classmap": [
            "database/seeds",
            "database/factories"
        ],
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Http/Helpers/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": [
            ]
        }
    },
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
